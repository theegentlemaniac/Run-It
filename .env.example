# Supabase project credentials
# Find these in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key, used for privileged operations (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used as the trusted OAuth redirect origin (falls back
# to the request's Origin header, then localhost, if unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox GL JS public access token
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=
