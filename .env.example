# Supabase project credentials
# Find these in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional local/demo login credentials. A matching user must first be
# created in the Supabase Auth dashboard. Never use these as production config.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

# Server-only key, used for privileged operations (never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used as the trusted OAuth redirect origin. Required in
# production (falls back to the request's Origin header, then localhost,
# in local development only)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox GL JS public access token
# https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=
